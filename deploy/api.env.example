# /etc/futurenestfund/api.env: settings for the running API (docs/DEPLOY.md).
# Owner root, group futurenestfund, mode 640. Real values come from secrets.local.md; never commit them.
# One VAR=value per line, no spaces around "=", double quotes around values with spaces.

NODE_ENV=production
PORT=3200
HOST=127.0.0.1
# nginx is the one proxy in front (Cloudflare set to "DNS only").
TRUST_PROXY=1
APP_URL=https://access.futurenestfund.org
UPLOAD_DIR=/var/lib/futurenestfund/uploads

SUPABASE_URL=https://fybslfcepjnswcnoewgi.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE
# The restricted app_api user (not postgres), through the session pooler: the VPS has no IPv6.
SUPABASE_DB_URL=postgresql://app_api.fybslfcepjnswcnoewgi:REPLACE_APP_DB_PASSWORD@aws-1-eu-central-1.pooler.supabase.com:5432/postgres

# Master key that encrypts the email secrets saved in Admin Settings → Email (Resend API key, hook secret).
# Not needed: without it the API creates /var/lib/futurenestfund/settings.key itself (next to UPLOAD_DIR, mode 600).
# Only set this to supply your own key (openssl rand -base64 32); it then wins over the file.
#SETTINGS_ENCRYPTION_KEY=

# Email is set up in Admin Settings → Email (docs/DEPLOY.md step 10). These lines are an optional fallback:
# a value saved in Settings wins over them.
#RESEND_API_KEY=re_REPLACE
#EMAIL_FROM="Future Nest Fund <no-reply@mail.futurenestfund.org>"
#EMAIL_REPLY_TO=grants@futurenestfund.org
#SUPPORT_EMAIL=help@futurenestfund.org
#SEND_EMAIL_HOOK_SECRET="v1,whsec_REPLACE"

# Optional error monitoring:
#SENTRY_DSN=https://REPLACE@o0.ingest.de.sentry.io/0

# Optional virus scanning of uploads (docs/DEPLOY.md step 11). Needs clamav-daemon on this server (~1 GB of memory).
# When set, uploads are refused while the scanner is down; CLAMAV_FAIL_OPEN=1 accepts them unscanned instead.
#CLAMAV_SOCKET=/var/run/clamav/clamd.ctl
#CLAMAV_FAIL_OPEN=1
