{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "declarationMap": true,
    "emitDeclarationOnly": true,
    "outDir": "dist",
    "rootDir": "src",
    // Generated multipart schemas use `zod.instanceof(Blob)`; Blob is global in Node 18+ but typed by the DOM lib.
    "lib": ["es2022", "dom"]
  },
  "include": ["src"]
}
